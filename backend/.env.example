PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL Direct Connection to Supabase Engine)
DB_HOST=db.ckrtechnologies.in
DB_PORT=5432
DB_NAME=postgres
DB_USER=connect_user
DB_PASSWORD=password@1
POOLER_TENANT_ID=your-tenant-id

# Direct Database URL (with Supabase pooler tenant identifier)
DATABASE_URL=postgresql://connect_user.your-tenant-id:password%401@db.ckrtechnologies.in:5432/postgres

# JWT Secret for Session Authentication
JWT_SECRET=ckr_connect_super_secret_jwt_key_2026_enterprise_isolated
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=ckr_connect_super_secret_refresh_jwt_key_2026_isolated
JWT_REFRESH_EXPIRES_IN=30d

# File Storage Configuration (Local VPS disk storage per AGENTS.md §2)
FILES_DIR=./uploads
MAX_FILE_SIZE_MB=25

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://connect.ckrtechnologies.in
